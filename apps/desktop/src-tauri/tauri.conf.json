{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pitwall",
  "mainBinaryName": "pitwall",
  "identifier": "dev.pitwall.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:0",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMzA5NzAwQkM5NjIyMDMKUldRRElwYThBSmN3cjQ4OHAreWRDK04wL3lUcnJYblJDaTRYMW1Ecmk5UG84ZFMxemFTZStaRUEK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
