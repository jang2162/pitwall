{
  "$comment": "@generated by pw-rpc-gen from the `rpc_method!` declarations. Do not edit. Regenerate: mise run gen",
  "methods": {
    "config.get": {
      "description": "병합된 설정 스냅숏. `projectId` 가 없으면 전역(`$CONFIG`), 있으면 그 프로젝트(설정을 붙여 연 프로젝트만).",
      "kind": "unary",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "projectId": {
            "default": null,
            "description": "없으면 전역 설정, 있으면 그 프로젝트의 설정.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "result": {
        "$defs": {
          "ConfigFault": {
            "description": "마지막 읽기의 실패. 성공하면 사라진다.",
            "properties": {
              "message": {
                "type": "string"
              },
              "path": {
                "description": "문제가 난 파일. 파일과 무관하면 `null`.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "message",
              "path"
            ],
            "type": "object"
          },
          "ConfigFile": {
            "properties": {
              "id": {
                "description": "설정 폴더 기준 경로에서 `.toml`/`.local.toml` 을 뗀 것. 구분자는 항상 `/`.",
                "type": "string"
              },
              "layers": {
                "description": "아래(먼저 적용)부터 위 순서.",
                "items": {
                  "$ref": "#/$defs/ConfigLayer"
                },
                "type": "array"
              },
              "value": {
                "description": "레이어를 병합한 값(JSON 객체). `schema` 키는 뺀다."
              }
            },
            "required": [
              "id",
              "value",
              "layers"
            ],
            "type": "object"
          },
          "ConfigLayer": {
            "properties": {
              "origin": {
                "$ref": "#/$defs/LayerOrigin"
              },
              "path": {
                "description": "파일 경로. 내장 기본값이면 `null`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "readOnly": {
                "description": "앱보다 새 스키마라 읽기만 하고 쓰지 않는 파일.",
                "type": "boolean"
              },
              "schema": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "origin",
              "path",
              "schema",
              "readOnly"
            ],
            "type": "object"
          },
          "ConfigNotice": {
            "oneOf": [
              {
                "description": "구버전 파일을 올려 썼다. 커밋되는 파일이면 「변경 사항 커밋 필요」 안내 대상이다(설계 D23).",
                "properties": {
                  "backup": {
                    "type": "string"
                  },
                  "from": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "kind": {
                    "const": "migrated",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "to": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "from",
                  "to",
                  "backup"
                ],
                "type": "object"
              },
              {
                "description": "앱보다 새 버전이라 읽기 전용으로 열었다(업데이트 안내 대상).",
                "properties": {
                  "found": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "kind": {
                    "const": "futureSchema",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "supported": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "found",
                  "supported"
                ],
                "type": "object"
              },
              {
                "description": "가리키는 파일이 없는 심링크라 건너뛰었다(dotfiles 가 아직 동기화되지 않은 경우 등).",
                "properties": {
                  "kind": {
                    "const": "brokenLink",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "type": "object"
              }
            ]
          },
          "ConfigSnapshot": {
            "description": "스냅숏: 파일 id 마다 병합된 값과, 이번 읽기에서 생긴 알림.",
            "properties": {
              "files": {
                "description": "id 순으로 정렬돼 있다.",
                "items": {
                  "$ref": "#/$defs/ConfigFile"
                },
                "type": "array"
              },
              "notices": {
                "items": {
                  "$ref": "#/$defs/ConfigNotice"
                },
                "type": "array"
              }
            },
            "required": [
              "files",
              "notices"
            ],
            "type": "object"
          },
          "LayerOrigin": {
            "oneOf": [
              {
                "enum": [
                  "builtin"
                ],
                "type": "string"
              },
              {
                "const": "shared",
                "description": "`<id>.toml` — 커밋되는 공유 설정(전역이면 그냥 설정 파일).",
                "type": "string"
              },
              {
                "const": "local",
                "description": "`<id>.local.toml` — 개인 덮어쓰기. 워크트리면 메인 체크아웃의 것일 수 있다.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "지금 적용 중인 설정과, 마지막 다시 읽기의 실패(있으면). 실패해도 `snapshot` 은 직전에 성공한 값이다.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConfigFault"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot": {
            "$ref": "#/$defs/ConfigSnapshot"
          }
        },
        "required": [
          "snapshot",
          "error"
        ],
        "type": "object"
      },
      "roles": [
        "owner",
        "mobile",
        "readonly"
      ],
      "tier": "read"
    },
    "config.paths": {
      "description": "해석된 `$CONFIG`/`$DATA`/`$STATE`/`$CACHE`. 설정 화면의 「설정 폴더 열기」 · 「경로 복사」 가 쓴다.",
      "kind": "unary",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "해석된 앱 디렉터리(`docs/design/03-architecture.md` 「5-0. 파일 위치 — XDG 규칙」). UTF-8 이 아닌 경로는 손실 변환된다.",
        "properties": {
          "cache": {
            "type": "string"
          },
          "config": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "config",
          "data",
          "state",
          "cache"
        ],
        "type": "object"
      },
      "roles": [
        "owner",
        "mobile",
        "readonly"
      ],
      "tier": "read"
    },
    "diag.collect": {
      "description": "「진단 정보 복사」의 텍스트: 버전 · OS · 활성 기능 · 크래시 리포트 설정 · 최근 경고와 오류 로그.\n경로 · 비밀 · 홈 디렉터리 이름은 가린다.",
      "kind": "unary",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "description": "경로 · 비밀 · 홈 디렉터리 이름을 가린 텍스트. 이슈 제보에 그대로 붙여 넣을 수 있다.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "roles": [
        "owner"
      ],
      "tier": "read"
    },
    "host.demoTask": {
      "description": "진행률을 내는 데모 작업을 띄우고 그 진행을 스트림으로 보낸다. 스트림을 취소하면 작업도 취소된다.\nTask · 이벤트 버스 · 스트림 취소가 transport 끝까지 이어지는지 확인하는 용도다.",
      "item": {
        "$defs": {
          "TaskProgress": {
            "description": "진행 양은 2^53 안에 머문다고 보고 TS `number` 로 낸다(pw-rpc `JsNumber`).\n없는 값은 키를 빼지 않고 `null` 로 보낸다 — specta 가 `skip_serializing_if` 를 TS 로 표현하지 못한다.",
            "properties": {
              "done": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "message": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "total": {
                "default": null,
                "description": "전체 양을 모르면 `None`(UI 는 불확정 진행 막대).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "done",
              "total",
              "message"
            ],
            "type": "object"
          },
          "TaskStatus": {
            "oneOf": [
              {
                "properties": {
                  "status": {
                    "const": "running",
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "status": {
                    "const": "completed",
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "error": {
                    "type": "string"
                  },
                  "status": {
                    "const": "failed",
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "error"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "status": {
                    "const": "cancelled",
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ],
                "type": "object"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "데모 작업 스트림의 청크. 진행 알림이 여러 번, 종료 알림이 마지막에 한 번 온다.",
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "progress",
                "type": "string"
              },
              "progress": {
                "$ref": "#/$defs/TaskProgress"
              },
              "taskId": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "taskId",
              "progress"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "finished",
                "type": "string"
              },
              "outcome": {
                "$ref": "#/$defs/TaskStatus"
              },
              "taskId": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "taskId",
              "outcome"
            ],
            "type": "object"
          }
        ]
      },
      "kind": "stream",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "intervalMs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "steps": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "steps",
          "intervalMs"
        ],
        "type": "object"
      },
      "roles": [
        "owner",
        "mobile",
        "readonly"
      ],
      "tier": "read"
    },
    "host.info": {
      "description": "Host 의 종류 · 버전 · OS.",
      "kind": "unary",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "arch": {
            "type": "string"
          },
          "hostId": {
            "type": "string"
          },
          "kind": {
            "description": "`local`(데스크톱 프로세스 안) 또는 `relay`(원격 데몬).",
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "hostId",
          "kind",
          "version",
          "os",
          "arch"
        ],
        "type": "object"
      },
      "roles": [
        "owner",
        "mobile",
        "readonly"
      ],
      "tier": "read"
    },
    "host.ping": {
      "description": "연결 확인. 받은 `nonce` 와 응답한 Host 의 id 를 돌려준다.",
      "kind": "unary",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "nonce": {
            "default": "",
            "description": "그대로 돌려받는 값. 클라이언트가 응답을 자기 요청과 맞춰 보는 데 쓴다.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "hostId": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          }
        },
        "required": [
          "nonce",
          "hostId"
        ],
        "type": "object"
      },
      "roles": [
        "owner",
        "mobile",
        "readonly"
      ],
      "tier": "read"
    },
    "log.write": {
      "description": "UI(웹뷰)가 남긴 로그를 UI 로그 파일(`$STATE/logs/ui.<날짜>.log`)에 쓴다. 웹뷰는 항목을 모아 묶음으로 보낸다.\n한 번에 200개, 메시지 하나에 8 KiB 까지 받고 넘는 것은 버리거나 자른다.",
      "kind": "unary",
      "params": {
        "$defs": {
          "UiLogEntry": {
            "properties": {
              "level": {
                "$ref": "#/$defs/UiLogLevel"
              },
              "message": {
                "type": "string"
              },
              "source": {
                "default": null,
                "description": "어디서 남겼는지(모듈 이름, `window.error` 등). 경로나 사용자 입력을 넣지 않는다.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "level",
              "message"
            ],
            "type": "object"
          },
          "UiLogLevel": {
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "dropped": {
            "default": 0,
            "description": "보내기 전에 웹뷰 쪽 대기열이 넘쳐 버린 항목 수.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "entries": {
            "items": {
              "$ref": "#/$defs/UiLogEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      },
      "roles": [
        "owner"
      ],
      "tier": "write"
    }
  }
}
